# ==============================================================================
# EMAIL AUTOMATION SYSTEM CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Email Service Provider Selection
# ------------------------------------------------------------------------------
# Options: 'smtp' or 'api'
EMAIL_PROVIDER=smtp

# ------------------------------------------------------------------------------
# 2. SMTP Server Credentials (used when EMAIL_PROVIDER=smtp)
# ------------------------------------------------------------------------------
# Standard SMTP hosts:
# - Gmail:   smtp.gmail.com   (Port 587 for STARTTLS or 465 for SSL)
# - Outlook: smtp.office365.com (Port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com

# ------------------------------------------------------------------------------
# HOW TO GET A GMAIL APP PASSWORD:
# 1. Go to your Google Account (https://myaccount.google.com/)
# 2. Navigate to Security > 2-Step Verification (ensure 2FA is turned ON)
# 3. Scroll to the bottom and click "App passwords"
# 4. Enter an app name (e.g. "Email Automation"), click Create, and copy the 16-character password
# 5. Paste the 16-character code below into SMTP_PASSWORD (without spaces)
# ------------------------------------------------------------------------------
SMTP_PASSWORD=your_16_digit_app_password

# ------------------------------------------------------------------------------
# 3. Email REST API Credentials (used when EMAIL_PROVIDER=api)
# ------------------------------------------------------------------------------
# Options: 'sendgrid' or 'mailgun'
API_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain.com

# ------------------------------------------------------------------------------
# 4. Sender Details & Throttling Controls
# ------------------------------------------------------------------------------
FROM_NAME=Your Company
FROM_EMAIL=your_email@gmail.com

# Max retries per failed send attempt with exponential backoff (2s, 4s, 8s...)
RETRY_LIMIT=3

# Delay in seconds between bulk sends to prevent provider rate-limiting
SEND_DELAY_SECONDS=0.5
